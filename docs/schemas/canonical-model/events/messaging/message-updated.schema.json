{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://car.local/schemas/canonical-model/events/messaging/message-updated.schema.json",
  "title": "CAR Message Updated Event",
  "description": "Specialized canonical event schema for message.updated events (message edits).",
  "allOf": [
    { "$ref": "../../canonical-event-envelope.schema.json" },
    {
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "message.updated" },
        "payload": {
          "type": "object",
          "required": ["original_message_id", "new_text"],
          "properties": {
            "original_message_id": { "type": "string", "minLength": 1 },
            "new_text": { "type": "string", "minLength": 1 },
            "previous_text": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
