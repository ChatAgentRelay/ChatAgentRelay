{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://car.local/schemas/canonical-model/events/messaging/reaction-received.schema.json",
  "title": "CAR Reaction Received Event",
  "description": "Specialized canonical event schema for reaction.received events.",
  "allOf": [
    { "$ref": "../../canonical-event-envelope.schema.json" },
    {
      "type": "object",
      "required": ["event_type", "payload", "actor_type"],
      "properties": {
        "event_type": { "const": "reaction.received" },
        "actor_type": { "const": "end_user" },
        "payload": {
          "type": "object",
          "required": ["emoji", "target_message_id"],
          "properties": {
            "emoji": { "type": "string", "minLength": 1 },
            "target_message_id": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "enum": ["added", "removed"] }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
